[Unit]
Description=Gnomon RFC 10049 Roughtime server
Documentation=https://github.com/NaomiAmethyst/gnomon
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
ConditionPathExists=/etc/gnomon/gnomon.toml
ConditionPathExists=/etc/gnomon/online.key
ConditionPathExists=/etc/gnomon/delegation.cert

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/gnomond --config /etc/gnomon/gnomon.toml
LoadCredential=online.key:/etc/gnomon/online.key
Restart=on-failure
RestartSec=10s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Re-allow read-only clock queries. Capabilities remain empty, so Linux
# rejects attempts to modify time. ProtectClock would block these queries too.
SystemCallFilter=adjtimex clock_adjtime clock_adjtime64
LimitNOFILE=1024
TasksMax=64
MemoryMax=128M

[Install]
WantedBy=multi-user.target
